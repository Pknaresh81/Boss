{
  "name": "Boss",
  "version": "1.0.0",
  "description": "IRCTC Train Booking Automation",
  "main": "main.js",
  "author": "Boss",
 "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis && node -e \"require('fs').readdirSync('dist').filter(f=>f!=='BOSS.exe').forEach(f=>require('fs').rmSync('dist/'+f,{recursive:true,force:true}))\""
},
  "dependencies": {
    "axios": "^1.20.0",
    "firebase": "^12.19.0",
    "puppeteer": "^24.17.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
"build": {
    "appId": "com.boss.automation",
    "productName": "Boss",
    "artifactName": "BOSS.exe",
    "win": {
        "target": "nsis",
        "icon": "build/BOSS-icon.ico"
    },
    "nsis": {
        "include": "build/installer.nsh"
    }
}
}